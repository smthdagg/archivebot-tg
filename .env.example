# ============ Telegram ============
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs that bootstrap as SUPER_ADMIN
ADMIN_IDS=

# Default language: zh-CN | en-US | auto (fall back to Telegram language_code)
DEFAULT_LANGUAGE=auto

# ============ Database / Queue ============
# SQLite for MVP: sqlite:///data/archivebot.db
# PostgreSQL (later): postgresql+psycopg://user:pass@postgres:5432/archivebot
DATABASE_URL=sqlite:///data/archivebot.db
REDIS_URL=redis://redis:6379/0

# ============ Storage (temporary file pool) ============
STORAGE_DIR=/storage
STORAGE_SOFT_LIMIT_MB=800
STORAGE_HARD_LIMIT_MB=1024
STORAGE_CLEANUP_TARGET_MB=200

# ============ Limits / concurrency ============
MAX_FILE_SIZE_MB=200
MAX_TASK_SIZE_MB=300
MAX_USER_CONCURRENCY=2
MAX_GLOBAL_CONCURRENCY=4
TASK_TIMEOUT_SECONDS=600
RETRY_COUNT=2

# ============ Features ============
PDF_ENABLED=true
MARKDOWN_ENABLED=true
IMAGE_ENABLED=true
AI_SUMMARY_ENABLED=false

# ============ SSRF ============
# CIDR ranges exempt from private-range blocking (default: Clash/sing-box fake-IP DNS)
SSRF_ALLOWED_CIDRS=198.18.0.0/15

# ============ Cookie Profile (Phase 2, login-required sites) ============
# Optional. Load profile → platform → cookies for login-only archiving.
# CRITICAL: profiles are ONLY used for sites the user themself logged into;
# never for bypassing paywalls or access control.
# Two sources (both optional, merged):
#   1) COOKIE_PROFILES: inline JSON string
#   2) COOKIE_PROFILES_FILE: path to a JSON file
# Schema (Cookie-Editor format, one list per platform):
#   { "<profile name>": { "<platform>": [ {"name": "...", "value": "...", "domain": ".example.com", "path": "/"} ] } }
# Supported platforms: wechat, xhs, reddit, zhihu.
# Unsupported (recorded, ignored): web, weibo, twitter.
# Example (wechat + xhs):
# COOKIE_PROFILES={"login1":{"wechat":[{"name":"sn","value":"...","domain":".mp.weixin.qq.com","path":"/"}],"xhs":[{"name":"web_session","value":"...","domain":".xiaohongshu.com","path":"/"}]}}
# COOKIE_PROFILES_FILE=/etc/archivebot/cookie_profiles.json

# ============ Web Admin ============
WEB_ADMIN_HOST=0.0.0.0
WEB_ADMIN_PORT=8080
# Secret used to sign admin session cookies
WEB_ADMIN_SECRET=change-me-to-a-long-random-string
# Admin login password (single-account MVP; RBAC identity comes from ADMIN_IDS)
WEB_ADMIN_PASSWORD=change-me-strong-password
